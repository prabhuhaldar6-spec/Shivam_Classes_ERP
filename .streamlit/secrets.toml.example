# Copy this file to secrets.toml (same folder) and fill in your real values.
# Get these from: Supabase dashboard -> Project Settings -> API
# NEVER upload the real secrets.toml to GitHub — add it to .gitignore.

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-public-key"

# SUPABASE_SERVICE_KEY is powerful — it can bypass all security rules.
# Find it under Project Settings -> API -> "Secret keys" (starts with sb_secret_...).
# It is used ONLY by the Admin Dashboard, on the server side, to create
# teacher/parent logins. Never share this key or put it in a public place.
SUPABASE_SERVICE_KEY = "your-secret-service-role-key"
